{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@theateros/foundations",
  "private": true,
  "packageManager": "bun@1.3.6",
  "workspaces": {
    "packages": [
      "packages/failure",
      "packages/result",
      "packages/match",
      "packages/futur",
      "packages/publisher"
    ],
    "catalog": {
      "@types/bun": "1.3.6",
      "typescript": "^5",
      "release-it": "19.2.4",
      "tsup": "8.5.1"
    }
  },
  "scripts": {
    "lint": "biome check .",
    "test": "turbo test",
    "clean:dist": "bun .scripts/clean-dist.ts",
    "build:dist": "bun run clean:dist && bun run .scripts/build-dist.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@types/bun": "1.3.6",
    "chalk": "5.6.2",
    "release-it": "19.2.4",
    "tsup": "8.5.1",
    "turbo": "2.7.5",
    "typescript": "^5"
  }
}
